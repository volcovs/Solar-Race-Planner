# Copy to .env and fill in. .env is git-ignored.

# Database URL (Postgres + PostGIS)
# Local Docker Compose default:
SRP_DATABASE_URL=postgresql://srp:srp@localhost:5432/srp
# Northflank hosted (secret - set in Northflank environment variables):
# SRP_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# Data storage directory for GeoParquet files (defaults to /data in container or ./data locally)
SRP_DATA_DIR=data

# Frontend allowed origins for CORS (comma-separated)
SRP_CORS_ORIGINS=http://localhost:5173
